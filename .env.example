# Copy to .env. Never commit real credentials.
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
CRUSTDATA_API_KEY=
# Credentials live in ~/.aws/credentials under this event-only profile.
AWS_PROFILE=neathack
AWS_REGION=us-east-1
# Model inference is separate from sponsor data and infrastructure access.
DEEPSEEK_API_KEY=
